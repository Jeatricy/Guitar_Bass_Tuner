<Window x:Class="GuitarBassTuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:GuitarBassTuner.Controls"
        Title="弦准 · 吉他和贝斯调音器" Width="1180" Height="790" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" xml:lang="zh-CN">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="66" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True" Background="{StaticResource BackdropBrush}">
            <Ellipse Width="720" Height="590" Margin="-300,-290,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#99FF90B7" Offset="0"/>
                        <GradientStop Color="#00FF90B7" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="830" Height="660" Margin="0,0,-335,-315" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#A57ACCF9" Offset="0"/>
                        <GradientStop Color="#007ACCF9" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="{StaticResource SurfaceBrush}">
            <Grid Margin="24,0,13,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="14" Background="{StaticResource LogoBrush}">
                        <Path Data="M 0,9 L 4,9 7,3 11,15 15,5 18,9 22,9" Stroke="White" StrokeThickness="1.85"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="弦准" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
                    <Border Width="1" Height="15" Background="{StaticResource RuleBrush}" Margin="14,0"/>
                    <TextBlock Text="吉他和贝斯调音器" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化">
                        <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="最大化"
                            AutomationProperties.Name="最大化">
                        <Path x:Name="MaximizeGlyph" Data="M 0,0 H 9 V 9 H 0 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.15"/>
                    </Button>
                    <Button Style="{StaticResource WindowButton}" Click="Close_Click" ToolTip="关闭" AutomationProperties.Name="关闭">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,19,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="17"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="41"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource PanelBackdrop}"/>
            <Border Style="{StaticResource PanelContent}" Padding="15,10,15,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="142"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="乐器"/>
                        <Border Style="{StaticResource Segments}" Height="39">
                            <UniformGrid Rows="1" Columns="2">
                                <RadioButton x:Name="GuitarButton" Style="{StaticResource Segment}" Content="吉他"
                                             GroupName="Instrument" IsChecked="True" Click="Instrument_Click"/>
                                <RadioButton x:Name="BassButton" Style="{StaticResource Segment}" Content="贝斯"
                                             GroupName="Instrument" Click="Instrument_Click"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="定调"/>
                        <ComboBox x:Name="PresetPicker" Style="{StaticResource PresetPicker}" Height="39" MaxDropDownHeight="300"
                                  DisplayMemberPath="Name" SelectionChanged="Preset_SelectionChanged"
                                  AutomationProperties.Name="定调"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="选弦模式"/>
                        <Border Style="{StaticResource Segments}" Height="39">
                            <UniformGrid Rows="1" Columns="2">
                                <RadioButton x:Name="AutoButton" Style="{StaticResource Segment}" Content="自动识别"
                                             GroupName="StringMode" IsChecked="True" Click="Mode_Click"/>
                                <RadioButton x:Name="ManualButton" Style="{StaticResource Segment}" Content="手动选弦"
                                             GroupName="StringMode" Click="Mode_Click"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="5" Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="音频输入"/>
                        <ComboBox x:Name="InputPicker" Style="{StaticResource PresetPicker}" Height="39" MaxDropDownHeight="320"
                                  SelectionChanged="Input_SelectionChanged" AutomationProperties.Name="音频输入">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.31*" MinWidth="258" MaxWidth="340"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="0.69*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelBackdrop}"/>
                <Border Style="{StaticResource PanelContent}" Padding="16,15,16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="11"/>
                            <RowDefinition Height="51"/>
                            <RowDefinition Height="7"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="琴弦"/>
                            <TextBlock x:Name="StringStatus" Text="等待选弦" Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Row="1" Height="31" Margin="0,9,0,0">
                            <Border x:Name="GuitarHeadstocks" Style="{StaticResource Segments}" Padding="2">
                                <UniformGrid Rows="1" Columns="2">
                                    <RadioButton x:Name="SplitHeadstock" Style="{StaticResource Segment}" Content="两侧 3+3"
                                                 GroupName="Headstock" IsChecked="True" Click="Headstock_Click"
                                                 AutomationProperties.Name="吉他琴头，两侧各三个旋钮"/>
                                    <RadioButton x:Name="InlineHeadstock" Style="{StaticResource Segment}" Content="左侧 6 个"
                                                 GroupName="Headstock" Click="Headstock_Click"
                                                 AutomationProperties.Name="吉他琴头，左侧六个旋钮"/>
                                </UniformGrid>
                            </Border>
                            <TextBlock x:Name="BassHeadstock" Text="琴头 · 左侧 4 个" Visibility="Collapsed" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                        <Border Grid.Row="3" CornerRadius="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Background="{StaticResource InputBrush}" ClipToBounds="True">
                            <controls:InstrumentView x:Name="Neck" StringSelected="Neck_StringSelected"/>
                        </Border>
                        <UniformGrid x:Name="StringButtons" Grid.Row="5" Rows="1" Margin="-2,0"/>
                        <TextBlock Grid.Row="7" Text="点击琴弦或音名可锁定弦位" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelBackdrop}"/>
                <Border Grid.Column="2" Style="{StaticResource PanelContent}" Padding="20,17,20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="13"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.16*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="当前音"/>
                                <TextBlock x:Name="DetectedNote" Style="{StaticResource MetricValue}" Text="—"/>
                                <TextBlock x:Name="DetectedHz" Style="{StaticResource MetricDetail}" Text="— Hz" Margin="1,3,0,0"
                                           FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1,0,0,0" Padding="15,0,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="目标音"/>
                                    <TextBlock x:Name="TargetNote" Style="{StaticResource MetricValue}" Text="—"/>
                                    <TextBlock x:Name="TargetHz" Style="{StaticResource MetricDetail}" Text="— Hz" Margin="1,3,0,0"
                                               FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="{StaticResource RuleBrush}" BorderThickness="1,0,0,0" Padding="15,0,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="偏差 · 音分"/>
                                    <TextBlock x:Name="CentsValue" Style="{StaticResource MetricValue}" Text="—" FontSize="40"
                                               Foreground="{StaticResource AccentInkBrush}"/>
                                    <TextBlock x:Name="PitchDirection" Style="{StaticResource MetricDetail}" Text="等待音高" Margin="1,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" Background="{StaticResource RuleBrush}"/>
                        <Grid Grid.Row="4" Margin="2,0">
                            <TextBlock Text="实时音高" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Rectangle Width="12" Height="2" RadiusX="1" RadiusY="1" Fill="{StaticResource InTuneBrush}" Margin="0,1,6,0"/>
                                <TextBlock Text="目标音 ±3 音分" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
                                <Border Width="1" Height="10" Background="{StaticResource RuleBrush}" Margin="10,0"/>
                                <TextBlock Text="A4 = 440 Hz" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                                           FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                        </Grid>
                        <controls:PitchGraph x:Name="Graph" Grid.Row="6"
                                             AutomationProperties.Name="过去八秒的音高偏差曲线，右侧指针标出实时偏差"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource PanelBackdrop}" CornerRadius="15"/>
            <Border Grid.Row="4" Style="{StaticResource PanelContent}" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <Ellipse DockPanel.Dock="Left" x:Name="InputDot" Width="7" Height="7" Fill="{StaticResource DimBrush}"
                                 Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" x:Name="InputStatus" Text="正在查找输入" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="InputName" Text="音频输入" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="输入电平" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <controls:InputMeter x:Name="Meter" Width="104" Height="8" Margin="10,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LevelValue" Text="−∞ dB" Width="61" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
